; Optional standalone visual study. Not embedded in the iOS application yet.
config_version=5
[application]
config/name="Ciranda — estudo 3D"
run/main_scene="res://Main.tscn"
[display]
window/size/viewport_width=1000
window/size/viewport_height=700
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.08, 0.12, 1)
